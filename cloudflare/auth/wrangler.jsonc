{
  // Worker d'identité de la fédération : auth.fsggb.workers.dev (voir src/index.js).
  // Déploiement : cd cloudflare/auth && npx wrangler deploy
  "name": "auth",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Même base D1 que le Worker principal « scouthub » (users, sessions, login_codes, magic_links, portees, sso_codes…)
  "d1_databases": [
    { "binding": "DB", "database_name": "scouthub", "database_id": "1fbba344-d555-438e-b948-7bffefe30e5b" }
  ],
  // Compte de service Google « Intranet general » (envoi du code et du lien magique, lecture de la feuille « Outils »)
  "secrets_store_secrets": [
    { "binding": "GMAIL_SA_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "GMAIL_SA_KEY" }
  ],
  "vars": {
    "ORIGINES": "https://fsggb.github.io,https://intranet.fsggb.workers.dev",
    "GOOGLE_CLIENT_ID": "746804418411-qp582kgsv182ljo33vs0hh3dbcu75kie.apps.googleusercontent.com",
    "GOOGLE_DOMAINE": "fsggb.fr",
    "GMAIL_SENDER": "service-informatique@fsggb.fr",
    "ADMIN_EMAIL": "jb.combet@fsggb.fr",
    "ADMIN_GOOGLE": "service-informatique@fsggb.fr",
    "SESSION_JOURS": "14",
    "CODE_QUOTA_JOUR": "90",
    "SITE_RETOUR": "https://fsggb.github.io/ScoutHub/"
  }
  // Secret du Worker (jamais dans le dépôt) : SSO_CLES, JSON {"identifiant d'application": "clé"} — une clé par
  // application autorisée à échanger un code SSO (npx wrangler secret put SSO_CLES). Absent = SSO désactivé.
}
