{
  // Serveur Cloudflare de ScoutHub (plan gratuit) : relais ChatGDB et crédits, relais des cartes IGN (SCAN 25).
  // Déploiement : npx wrangler deploy   (jeton CLOUDFLARE_API_TOKEN et CLOUDFLARE_ACCOUNT_ID dans l'environnement)
  "name": "scouthub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Déclencheur régulier : relance la synchronisation des applications (workflow GitHub « Synchroniser ») toutes les 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },
  // Workers AI (modèles gratuits : 10 000 Neurons par jour pour le compte) : laboratoire de l'administrateur
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "scouthub", "database_id": "1fbba344-d555-438e-b948-7bffefe30e5b" }
  ],
  // Partage en direct de ScoutMap : un Durable Object par partage (stockage SQLite, offre gratuite)
  "durable_objects": { "bindings": [{ "name": "PARTAGE", "class_name": "Partage" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partage"] }],
  // Secrets du compte (Secrets Store « default_secrets_store »), lus avec await env.NOM.get()
  "secrets_store_secrets": [
    { "binding": "ANTHROPIC_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "ANTHROPIC_KEY" },
    { "binding": "IGN_SCAN25_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "IGN_SCAN25_KEY" },
    { "binding": "GITHUB_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "GITHUB_KEY" },
    // Compte de service Google « Intranet general » (intranet-general-serveur@intranet-general.iam.gserviceaccount.com,
    // délégation à l'échelle du domaine autorisée le 26/11/2026, portées gmail.send et drive) : code et lien magique par e-mail.
    { "binding": "GMAIL_SA_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "GMAIL_SA_KEY" }
  ],
  "vars": {
    // intranet.fsggb.workers.dev : site de test (nom choisi par l'administrateur, remplace scouthub-vrai-test) —
    // à retirer une fois la migration validée et le vrai portail basculé dessus.
    "ORIGINES": "https://fsggb.github.io,https://intranet.fsggb.workers.dev",
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_0119AE1DuVBLZoxQXQhqT3rB",
    "IGN_COUCHE": "GEOGRAPHICALGRIDSYSTEMS.MAPS.SCAN25TOUR",
    "CREDITS_FENETRE": "30",
    "FENETRE_HEURES": "5",
    "CREDITS_SEMAINE": "60",
    "BONUS_MAX": "40",
    "NEURONS_JOUR": "10000",
    "TURN_KEY_ID": "29924b06b96b9c981e6d91e7eaf53265",
    // ---- Identité et sessions (rupture avec Apps Script, voir cloudflare/MIGRATION.md) ----
    // Nouveau client OAuth « Intranet general - Web » (projet intranet-general), remplace l'ancien client
    // « Contacts des groupes » (599247454430-…, resté dans le projet Apps Script Connexion Outils FSGGB,
    // inchangé, toujours utilisé par les Apps Script). Identifiant public (pas un secret).
    "GOOGLE_CLIENT_ID": "746804418411-qp582kgsv182ljo33vs0hh3dbcu75kie.apps.googleusercontent.com",
    "GOOGLE_DOMAINE": "fsggb.fr",
    // Provisoire : no-reply@fsggb.fr n'existe pas encore comme boîte/alias du domaine (Google a refusé
    // l'envoi, « Invalid email or User ID »). À remettre sur no-reply@fsggb.fr une fois l'alias créé.
    "GMAIL_SENDER": "service-informatique@fsggb.fr",
    "ADMIN_EMAIL": "jb.combet@fsggb.fr",
    "ADMIN_GOOGLE": "service-informatique@fsggb.fr",
    "CLASSEUR_ID": "1a5kRDIxKSzTQe41KtVgSlgzVB6oj9aPEYYxvy7Z7Qxs",   // classeur « intranet » : feuilles Outils (lues par le compte de service)
    // Seule adresse autorisée à ouvrir les données sensibles (ré-authentification Google récente requise)
    "DONNEES_ADMINS": "jb.combet@fsggb.fr",
    "SESSION_JOURS": "14",
    "CODE_QUOTA_JOUR": "90",
    "SITE_RETOUR": "https://fsggb.github.io/ScoutHub/"
  }
  // Appels vocaux de ScoutMap : TURN_KEY_ID (identifiant de la clé Cloudflare Realtime TURN) et, en secret du Worker, TURN_KEY_TOKEN
  // (npx wrangler secret put TURN_KEY_TOKEN). Secret propre au Worker (npx wrangler secret put RELAIS_SECRET) : le même que la propriété RELAIS_CLOUDFLARE_SECRET
  // du serveur ScoutHub (Apps Script). Variable facultative : ANTHROPIC_WORKSPACE_ID (identifiant, pas un secret).
}
