{
  // Serveur Cloudflare de ScoutHub (plan gratuit) : relais ChatGDB et crédits, relais des cartes IGN (SCAN 25).
  // Déploiement : npx wrangler deploy   (jeton CLOUDFLARE_API_TOKEN et CLOUDFLARE_ACCOUNT_ID dans l'environnement)
  "name": "scouthub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Déclencheur régulier : relance la synchronisation des applications (workflow GitHub « Synchroniser ») toutes les 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },
  // Workers AI (modèles gratuits : 10 000 Neurons par jour pour le compte) : laboratoire de l'administrateur
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "scouthub", "database_id": "1fbba344-d555-438e-b948-7bffefe30e5b" }
  ],
  // Partage en direct de ScoutMap : un Durable Object par partage (stockage SQLite, offre gratuite)
  "durable_objects": { "bindings": [{ "name": "PARTAGE", "class_name": "Partage" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partage"] }],
  // Secrets du compte (Secrets Store « default_secrets_store »), lus avec await env.NOM.get()
  "secrets_store_secrets": [
    { "binding": "ANTHROPIC_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "ANTHROPIC_KEY" },
    { "binding": "IGN_SCAN25_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "IGN_SCAN25_KEY" },
    { "binding": "GITHUB_KEY", "store_id": "0d38faa59339406ca83b45947aab0995", "secret_name": "GITHUB_KEY" }
  ],
  "vars": {
    "ORIGINES": "https://fsggb.github.io",
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_0119AE1DuVBLZoxQXQhqT3rB",
    "IGN_COUCHE": "GEOGRAPHICALGRIDSYSTEMS.MAPS.SCAN25TOUR",
    "CREDITS_FENETRE": "30",
    "FENETRE_HEURES": "5",
    "CREDITS_SEMAINE": "60",
    "BONUS_MAX": "40",
    "NEURONS_JOUR": "10000",
    "TURN_KEY_ID": "29924b06b96b9c981e6d91e7eaf53265"
  }
  // Appels vocaux de ScoutMap : TURN_KEY_ID (identifiant de la clé Cloudflare Realtime TURN) et, en secret du Worker, TURN_KEY_TOKEN
  // (npx wrangler secret put TURN_KEY_TOKEN). Secret propre au Worker (npx wrangler secret put RELAIS_SECRET) : le même que la propriété RELAIS_CLOUDFLARE_SECRET
  // du serveur ScoutHub (Apps Script). Variable facultative : ANTHROPIC_WORKSPACE_ID (identifiant, pas un secret).
}
